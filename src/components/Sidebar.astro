---
import { NAV_ITEMS } from "../data/nav";
import type { NavKey } from "../data/types";

interface Props {
  active: NavKey;
}

const { active } = Astro.props;
---

<aside class="sidebar">
  <nav>
    {
      NAV_ITEMS.map((item) => (
        <a href={item.href} class={item.key === active ? "active" : ""}>
          {item.label}
        </a>
      ))
    }
  </nav>
</aside>
