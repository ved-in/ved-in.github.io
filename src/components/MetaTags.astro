---
// Open Graph + Twitter Card tags. These are what Slack, Discord, X,
// WhatsApp, iMessage, etc. read when they build a link preview.
//
// Every URL here must be absolute - scrapers do not resolve relative
// paths - so we build them against `site` from astro.config.mjs.
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
}

const { title, description, image, type = "website", publishedTime } = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = image ? new URL(image, site) : undefined;
---

{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="ved-in" />
<meta property="og:title" content={title} />
<meta property="og:url" content={canonicalURL} />
{description && <meta property="og:description" content={description} />}
{
  imageURL && (
    <>
      <meta property="og:image" content={imageURL} />
      <meta property="og:image:alt" content={title} />
    </>
  )
}
{type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{imageURL && <meta name="twitter:image" content={imageURL} />}
<meta name="twitter:site" content="@ved_in_" />
